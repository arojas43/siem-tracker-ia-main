# Configuración del chatbot de SIEM

# OpenAI API Key (opcional - se puede usar LM Studio local)
OPENAI_API_KEY=sk-dummy-key-for-lm-studio

# Configuración del servidor
HOST=0.0.0.0
PORT=8001
ENVIRONMENT=development

# API de SIEM
SIEM_API_BASE_URL=http://localhost:8000
SIEM_API_TOKEN=your-siem-api-token-here

# LM Studio (servidor local)
LM_STUDIO_URL=http://localhost:1234
LM_STUDIO_MODEL=openai/gpt-oss-20b

# Configuración de logging
LOG_LEVEL=INFO

# Base de datos (opcional)
DATABASE_URL=sqlite:///./chatbot.db

# Redis (opcional para cache)
REDIS_URL=redis://localhost:6379

# Configuración de seguridad
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# RAG (documentos y vector store)
DOCS_DIR=backend/docs
VECTORSTORE_DIR=backend/vectorstore
EMBEDDINGS_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RETRIEVAL_TOP_K=4
RETRIEVAL_SEARCH_TYPE=mmr
MATRIX_USER_ID=admin
# Desactivar RAG temporalmente para pruebas sin vector store
DISABLE_RAG=true
